class Solution {
    public boolean isCircularSentence(String sentence) {
        String[] str = sentence.split(" ");
        if(str.length == 1){
            if(sentence.charAt(0) == sentence.charAt(sentence.length()-1)){
                return true;
            }
            return false;
        }
        int n = str.length;
        int i = 0;
        int j = i+1;
        while(j < n){
            if(checkChar(str[i], str[j])){
                i++;
                j++;
                continue;
            }else{
                return false;
            }
        }
        if(j == n){
           if(checkChar(str[n-1], str[0])){
                return true;
            } 
        }
        return false;
    }

    public boolean checkChar(String s1, String s2){

        if(s1.charAt(s1.length()-1) == s2.charAt(0)){
            return true;
        }
        return false;
    }
}