class Solution {
    public int[] decrypt(int[] code, int k) {
        
        int[] ans = new int[code.length];

        if(k==0){
            return ans;    
        }else if(k>0){
            int i = 0;
            int sum = 0;
            int j = 0;
            int count = 0;
            while(i < code.length){
               j = i+1;
               while(true){
                if(j>=code.length){
                    j = code.length-j;
                }
                count++;
                sum = sum + code[j];
                if(count == k){
                    ans[i] = sum;
                    i++;
                    sum = 0;
                    count = 0;
                    break;
                }
                j++;
               }
            }
        }else{
            int i = code.length-1;
            k = k * -1;
            int sum = 0;
            int j = 0;
            int count = 0;
            while(i >= 0){
               j = i-1;
               while(true){
                if(j<0){
                    j = code.length-1;
                }
                count++;
                sum = sum + code[j];
                if(count == k){
                    ans[i] = sum;
                    i--;
                    sum = 0;
                    count = 0;
                    break;
                }
                j--;
               }
            }
        }
        return ans;
    }
}