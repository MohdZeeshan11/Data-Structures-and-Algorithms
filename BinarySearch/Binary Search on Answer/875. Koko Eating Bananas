class Solution {
    public int minEatingSpeed(int[] piles, int h) {
        
        int low = 1;
        int high = piles[0];
        for(int i = 1; i < piles.length; i++){
            high = Math.max(high, piles[i]);
        }

        int ans = 0;
        while(low <= high){
            int mid = low + (high-low)/2;
            if(isCheck(mid, piles, h)){
                ans = mid;
                high = mid-1;
            }else{
                low = mid+1;
            }
        }
        return ans;
    }

    public boolean isCheck(int mid, int[] piles, int h){

        long countHour = 0;
        for(int i = 0; i < piles.length; i++){
            countHour = countHour + (long)(piles[i] + mid-1)/mid;
        }

        return countHour <= h;
    }
}