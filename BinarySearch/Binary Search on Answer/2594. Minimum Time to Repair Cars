class Solution {
    public long repairCars(int[] ranks, int cars) {
        
        long low = 1;
        long high = 100L * 1000000 * 1000000;
        long ans = 0;
        while(low <= high){

            long mid = low + (high-low)/2;

            if(isCheck(mid, ranks, cars)){
                ans = mid;
                high = mid-1;
            }else{
                low = mid+1;
            }
        }
        return ans;
    }

    public boolean isCheck(long mid, int[] ranks, int cars){
        long countCars = 0;
        for(int i = 0; i < ranks.length; i++){
            countCars = countCars + (long)Math.sqrt(mid/ranks[i]);
        }
        return countCars >= cars;
    }
}