class Solution {
    public int[] searchRange(int[] nums, int target) {
        
        int i = 0;
        int j = nums.length-1;
        int[] ans = new int[2];
        ans[0] = -1;
        ans[1] = -1;
       
        int lowerIndex = lowerBound(nums, target);

        if(nums.length > lowerIndex && nums[lowerIndex] == target){
            ans[0] = lowerIndex;
        }
        int upperIndex = upperBound(nums, target);

        if(upperIndex > 0 && nums[upperIndex-1] == target){
            ans[1] = upperIndex-1;
        }
        return ans;
    }

    public int lowerBound(int[] nums, int target){

        int i = 0;
        int j = nums.length-1;
        while(i <= j){
            int mid = i + (j-i)/2;

            if(nums[mid] >= target){
                j = mid-1;
            }else{
                i = mid+1;
            }
        }

        return i;
    }

       public int upperBound(int[] nums, int target){

        int i = 0;
        int j = nums.length-1;
        while(i <= j){
            int mid = i + (j-i)/2;

            if(nums[mid] <= target){
                i = mid+1;
            }else{
                j = mid-1;
            }
        }

        return i;
    }
}

// best way to do in using only one function

class Solution {
    public int[] searchRange(int[] nums, int target) {

        int lowerIndex = solution(nums, target, true);
        int upperIndex = solution(nums, target, false);

        int[] ans = new int[2];
        ans[0] = -1;
        ans[1] = -1;

        if(lowerIndex < nums.length && nums[lowerIndex] == target){
            ans[0] =  lowerIndex;
        }

        if(upperIndex > 0 && nums[upperIndex-1] == target){
            ans[1] = upperIndex-1;
        }

        return ans;
    }


    public int solution(int[] nums, int target, boolean isLower){
        int low = 0;
        int high = nums.length;

        while(low < high){
            int mid = low + (high-low)/2;

            if(isLower ? nums[mid] >= target : nums[mid] > target){
                high = mid;
            }else{
                low = mid+1;
            }
        }
        return low;
    }
}