class Solution {
    public int[] successfulPairs(int[] spells, int[] potions, long success) {
        
        Arrays.sort(potions);
        int[] ans = new int[spells.length];

        for(int i = 0; i < spells.length; i++){
            int index = lowerBound(potions, spells[i], success);
            ans[i] = potions.length - index;
        }
        return ans;
    }

    public int lowerBound(int[] arr, int spells, long target){
        int low = 0;
        int high = arr.length;

        while(high>low){
            int mid = low + (high-low)/2;

            if((long)arr[mid]*spells >= target){
                high = mid;
            }else{
                low = mid+1;
            }
        }

        return low;
    }
}