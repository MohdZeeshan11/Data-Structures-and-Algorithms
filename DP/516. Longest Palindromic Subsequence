class Solution {
    public int longestPalindromeSubseq(String s) {
        int n = s.length();
        int m = s.length();

        // return lcs(text1, text2, n, m);
        int[][] dp = new int[n + 1][m + 1];
        // for(int i = 0; i < dp.length; i++){
        //     Arrays.fill(dp[i], -1);
        // }
        // lcs(text1, text2, n, m, dp);

        // return dp[n][m];
        String reverse = new StringBuilder(s).reverse().toString();

        lcs(s, reverse, n, m, dp);
        return dp[n][m];
    }

    public void lcs(String text1, String text2, int n, int m, int[][] dp) {
        for (int i = 0; i <= n; i++) {
            for (int j = 0; j <= m; j++) {
                if (i == 0 || j == 0) {
                    dp[i][j] = 0;
                }
            }
        }

        for (int i = 1; i <= n; i++) {
            for (int j = 1; j <= m; j++) {
                if (text1.charAt(i - 1) == text2.charAt(j - 1)) {
                    dp[i][j] = 1 + dp[i - 1][j - 1];
                } else {
                    dp[i][j] = Math.max(dp[i][j - 1], dp[i - 1][j]);
                }
            }
        }

    }
}