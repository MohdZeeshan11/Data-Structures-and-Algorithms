class Solution {
    public int firstUniqChar(String s) {
        
        int index = -1;
        
        int[] count = new int[26];

        for(int i = 0; i < s.length(); i++){
            count[s.charAt(i) - 'a']++;
        }

        for(int i = 0; i < s.length(); i++){
            int postion = s.charAt(i) - 'a';
            if(count[postion] == 1){
                index = i;
                break;
            }
        }

        return index;
    }
}